<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Jellyfin 12.0 only (net10.0). -->
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">12.0</JellyfinVersion>
    <TargetFramework>net10.0</TargetFramework>
    <Version Condition="'$(Version)' == ''">1.0.5</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>Jellyfin.Plugin.Wyzie</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.Wyzie</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0-rc2" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0-rc2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wyzie.Common\Wyzie.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>
</Project>
